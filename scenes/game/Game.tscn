[node name="ControlsTitle" type="Label" parent="Hud/ControlsOverlay/Center/Panel/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.831, 0.952, 0.917, 1)
theme_override_font_sizes/font_size = 24
text = "HOW TO DEFEND"
horizontal_alignment = 1

[node name="ControlsText" type="Label" parent="Hud/ControlsOverlay/Center/Panel/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.78, 0.86, 0.83, 1)
theme_override_font_sizes/font_size = 14
text = "BUILDER    F1 selects and centres your builder. Right-click the ground to walk there (Shift queues). S stops.
BUILD      Pick a tower on the command card (bottom right, hotkeys Q W E R), then left-click inside your position; Shift-click queues more.
             The builder walks to the site and the tower rises over a few seconds. Gold is paid when construction starts.
             The preview turns green when valid, orange if it would seal a route, purple outside your position, yellow if unaffordable.
SELECT     Left-click a tower: Q upgrades, A S D F set its target (first / last / strongest / nearest), C sells or cancels construction, V or Esc deselects.
PAN        Arrow keys, middle-drag, the screen edge, or click and drag on the minimap (bottom left).
ZOOM       Mouse wheel.
ABILITY    C fires your builder's race ability during waves (Humans: Performance Review stuns nearby creeps).
MENU       F10 opens the menu.
CHAT       Enter to talk, Esc to cancel. /give 50 Name (or p3) sends gold; the +25 / +100 buttons on the scoreboard do too.
GOAL       Creeps leaving Positions 1-8 relay into Position 9. Only creeps crossing the final gate cost shared lives.
VIEWERS    Play with flair (clutch saves, multi-kills, fast boss kills, long mazes, flawless levels) to win viewers.
SPONSORS   Every 100K viewers a sponsor offers the team a run upgrade; the wave timer pauses until the host chooses."
autowrap_mode = 2

