[node name="ControlsText" type="Label" parent="Hud/ControlsOverlay/Center/Panel/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.78, 0.86, 0.83, 1)
theme_override_font_sizes/font_size = 14
text = "BUILD      Pick a tower in the palette, then left-click an open tile inside your highlighted position.
             The preview turns green when valid, orange if it would seal a route, purple outside your position, yellow if unaffordable.
SELECT     Left-click a placed tower to upgrade it, sell it, or change its target priority.
PAN        WASD / arrow keys, right-drag, or move the cursor to the edge of the battlefield.
ZOOM       Mouse wheel.
DESELECT   Escape.
